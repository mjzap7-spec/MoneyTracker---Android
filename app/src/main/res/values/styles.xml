<?xml version="1.0" encoding="utf-8"?>

<resources>
    <style name="SummaryTab" parent="SecondaryButton">
        <item name="backgroundTint">@color/summary_tab_background</item>
        <item name="android:textColor">@color/summary_tab_text</item>
        <item name="strokeColor">@color/summary_tab_stroke</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- ========================= -->
    <!-- Primary Button             -->
    <!-- ========================= -->

    <style
        name="PrimaryButton"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">52dp</item>

        <item name="android:textAllCaps">false</item>

        <item name="cornerRadius">16dp</item>

        <item name="backgroundTint">
            @color/primary_blue
        </item>

        <item name="android:textColor">
            @color/white
        </item>

        <item name="android:textSize">15sp</item>

        <item name="android:fontFamily">sans</item>

    </style>


    <!-- ========================= -->
    <!-- Secondary Button           -->
    <!-- ========================= -->

    <style
        name="SecondaryButton"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">48dp</item>

        <item name="android:textAllCaps">false</item>

        <item name="cornerRadius">14dp</item>

        <item name="backgroundTint">
            @color/card_background_light
        </item>

        <item name="strokeColor">
            @color/border_dark
        </item>

        <item name="strokeWidth">1dp</item>

        <item name="android:textColor">
            @color/text_primary
        </item>

        <item name="android:textSize">13sp</item>

    </style>


    <!-- ========================= -->
    <!-- Delete Button              -->
    <!-- ========================= -->

    <style
        name="DeleteButton"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">48dp</item>

        <item name="android:textAllCaps">false</item>

        <item name="cornerRadius">14dp</item>

        <item name="backgroundTint">
            @color/card_background_light
        </item>

        <item name="strokeColor">
            @color/expense_red
        </item>

        <item name="strokeWidth">1dp</item>

        <item name="android:textColor">
            @color/expense_red
        </item>

        <item name="android:textSize">13sp</item>

    </style>


    <!-- ========================= -->
    <!-- Custom Button              -->
    <!-- ========================= -->

    <style
        name="CustomButton"
        parent="Widget.Material3.Button">

        <item name="android:minHeight">48dp</item>

        <item name="android:textAllCaps">false</item>

        <item name="cornerRadius">14dp</item>

        <item name="backgroundTint">
            @color/primary_blue
        </item>

        <item name="android:textColor">
            @color/white
        </item>

    </style>


    <!-- ========================= -->
    <!-- Search Input               -->
    <!-- ========================= -->

    <style
        name="SearchInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">
            @color/primary_blue
        </item>

        <item name="hintTextColor">
            @color/text_muted
        </item>

        <item name="boxBackgroundColor">
            @color/input_background
        </item>

        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>

    </style>


    <!-- ========================= -->
    <!-- Transaction Input          -->
    <!-- ========================= -->

    <style
        name="TransactionInputLayout"
        parent="Widget.Material3.TextInputLayout.OutlinedBox">

        <item name="boxStrokeColor">
            @color/input_stroke
        </item>

        <item name="hintTextColor">
            @color/text_muted
        </item>

        <item name="boxBackgroundColor">
            @color/input_background
        </item>

        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>

    </style>

    <style name="QuietButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">48dp</item>
        <item name="android:minWidth">64dp</item>
        <item name="android:textColor">@color/primary_blue</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
