<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/screen_background" android:scrollbars="none" android:focusableInTouchMode="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/insights" android:textSize="28sp" android:textColor="@color/text_primary" android:textStyle="bold" />
    <TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="@string/insights_subtitle" android:textSize="14sp" android:textColor="@color/text_secondary" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
      <TextView android:id="@+id/currencyLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/currency" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
      <Spinner android:id="@+id/currencySpinner" android:layout_width="110dp" android:layout_height="48dp" android:background="@drawable/bg_spinner" android:paddingStart="12dp" android:paddingEnd="40dp" android:contentDescription="@string/currency" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="16dp">
      <com.google.android.material.button.MaterialButton android:id="@+id/previousButton" style="@style/SecondaryButton" android:layout_width="64dp" android:layout_height="48dp" android:text="‹" android:contentDescription="@string/previous_month" />
      <TextView android:id="@+id/monthLabel" android:layout_width="0dp" android:layout_weight="1" android:layout_height="48dp" android:gravity="center" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
      <com.google.android.material.button.MaterialButton android:id="@+id/nextButton" style="@style/SecondaryButton" android:layout_width="64dp" android:layout_height="48dp" android:text="›" android:contentDescription="@string/next_month" />
    </LinearLayout>
    <TextView android:id="@+id/totalsLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="" android:textSize="18sp" android:textColor="@color/text_primary" android:background="@drawable/bg_section_card" android:padding="16dp" android:lineSpacingExtra="8dp" />
    <com.google.android.material.button.MaterialButton style="@style/SecondaryButton" android:id="@+id/assistantButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/explain_spending_action" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_section_card">
      <TextView android:id="@+id/trendTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/spending_trend" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
      <TextView android:id="@+id/trendHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/trend_hint" android:textSize="13sp" android:textColor="@color/text_secondary" android:layout_marginTop="8dp" />
      <TextView android:id="@+id/trendLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" android:layout_marginTop="8dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_section_card">
      <TextView android:id="@+id/budgetTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/monthly_budget" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
      <TextView android:id="@+id/budgetLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="" android:textSize="14sp" android:textColor="@color/text_secondary" />
      <com.google.android.material.progressindicator.LinearProgressIndicator xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/budgetProgress" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp" app:trackCornerRadius="4dp" app:trackThickness="8dp" />
      <com.google.android.material.button.MaterialButton android:id="@+id/budgetButton" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/manage_budget" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:layout_marginTop="16dp" android:background="@drawable/bg_section_card">
      <TextView android:id="@+id/categoryTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="0dp" android:text="@string/spending_categories" android:textSize="18sp" android:textColor="@color/text_primary" android:textStyle="bold" />
      <LinearLayout android:id="@+id/categoryContainer" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </LinearLayout>
    <TextView android:id="@+id/statusLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="" android:textSize="16sp" android:textColor="@color/text_primary" />
    <com.google.android.material.button.MaterialButton android:id="@+id/retryButton" style="@style/SecondaryButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/retry" />
  </LinearLayout>
</ScrollView>