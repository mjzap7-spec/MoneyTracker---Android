<?xml version="1.0" encoding="utf-8"?>

<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/currencyFragment"
        android:name="com.example.moneytracker.ui.currency.CurrencyFragment"
        android:label="Exchange rates" tools:layout="@layout/fragment_currency" />

    <fragment android:id="@+id/insightsFragment" android:name="com.example.moneytracker.ui.insights.InsightsFragment" android:label="Insights" tools:layout="@layout/fragment_insights" />
    <fragment android:id="@+id/settingsFragment" android:name="com.example.moneytracker.ui.settings.SettingsFragment" android:label="Settings" tools:layout="@layout/fragment_settings" />
    <action android:id="@+id/action_logout" app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph" app:popUpToInclusive="false" />

    <fragment android:id="@+id/historyFragment"
        android:name="com.example.moneytracker.ui.history.HistoryFragment"
        android:label="History" tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.moneytracker.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />

    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.moneytracker.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">

        <action
            android:id="@+id/action_registerFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.moneytracker.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/dashboardFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_dashboardFragment_to_addTransactionFragment"
            app:destination="@id/addTransactionFragment" />

        <action
            android:id="@+id/action_dashboardFragment_to_editTransactionFragment"
            app:destination="@id/editTransactionFragment" />

    </fragment>

    <fragment
        android:id="@+id/addTransactionFragment"
        android:name="com.example.moneytracker.ui.transaction.AddTransactionFragment"
        android:label="Add Transaction"
        tools:layout="@layout/fragment_add_transaction" />

    <fragment
        android:id="@+id/editTransactionFragment"
        android:name="com.example.moneytracker.ui.transaction.EditTransactionFragment"
        android:label="Edit Transaction"
        tools:layout="@layout/fragment_edit_transaction" />

<fragment android:id="@+id/budgetsFragment" android:name="com.example.moneytracker.ui.budgets.BudgetsFragment" android:label="Budgets" tools:layout="@layout/fragment_budgets" />
<fragment android:id="@+id/assistantFragment" android:name="com.example.moneytracker.ui.assistant.AssistantFragment" android:label="AI assistant" tools:layout="@layout/fragment_assistant" />
<fragment android:id="@+id/helpFragment" android:name="com.example.moneytracker.ui.help.HelpFragment" android:label="Help" tools:layout="@layout/fragment_help" />
</navigation>
